PORT=3000
# Local Ollama only. The browser never contacts this address directly.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Brain keys are supplied in session by the user, not through this file.

# Optional private data location; defaults to .relay-data in the project.
# RELAY_DATA_DIR=

# Context units are conservative UTF-8 byte estimates, not exact model tokens.
# Increase only after checking both models' context capability and RAM/VRAM.
RELAY_LOCAL_CONTEXT=8192
RELAY_LOCAL_OUTPUT=1024
RELAY_BRAIN_CONTEXT=128000
RELAY_MAX_CHUNKS=12
# PDF worker: wall time and V8 old-generation heap cap, NOT total-process memory.
RELAY_PDF_TIMEOUT_MS=15000
RELAY_PDF_HEAP_MB=128
